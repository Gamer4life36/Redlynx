{
  "name": "redlynx",
  "version": "0.1.0",
  "description": "A stronger browser — built-in media downloader, ad/tracker blocking, power tabs, privacy by default.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run notice && electron-builder --win",
    "pack": "electron-builder --win --dir",
    "test": "node test/run.js",
    "build:signed": "npm run notice && electron-builder --win",
    "engine:check": "node scripts/engine-check.js",
    "engine:refresh": "npm i -D electron@latest && npm test && npm run dist",
    "dist:publish": "electron-builder --win --publish always",
    "notice": "node scripts/make-notice-rtf.js",
    "icon": "electron scripts/make-icon.js branding/redlynx-source.png branding/redlynx",
    "sources:check": "node scripts/check-sources.js",
    "engines:fetch": "node scripts/fetch-engines.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.5.0",
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.redlynx.browser",
    "productName": "Redlynx",
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "branding",
        "to": "branding",
        "filter": [
          "*.ico",
          "*.png"
        ]
      },
      {
        "from": "engines",
        "to": "engines",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "engines/tor",
        "to": "engines/tor"
      }
    ],
    "win": {
      "icon": "branding/redlynx.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Redlynx",
      "license": "build/notice.rtf",
      "include": "build/installer.nsh",
      "installerIcon": "branding/redlynx.ico",
      "uninstallerIcon": "branding/redlynx.ico",
      "installerHeaderIcon": "branding/redlynx.ico",
      "installerHeader": "build/header.bmp",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Gamer4life36",
        "repo": "Redlynx"
      }
    ]
  }
}
