{
  "name": "redlynx",
  "version": "0.1.0",
  "description": "A stronger browser — built-in media downloader, ad/tracker blocking, power tabs, privacy by default.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --win --dir",
    "test": "node test/run.js",
    "build:signed": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.5.0",
    "@mozilla/readability": "^0.6.0"
  },
  "build": {
    "appId": "com.redlynx.browser",
    "productName": "Redlynx",
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "branding",
        "to": "branding",
        "filter": [
          "*.ico",
          "*.png"
        ]
      },
      {
        "from": "engines",
        "to": "engines",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "engines/tor",
        "to": "engines/tor"
      }
    ],
    "win": {
      "icon": "branding/icon-3-redline-eye.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Redlynx"
    }
  }
}
